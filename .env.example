# GitHub App & Marketplace Server Configuration
PORT=3000
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-your-webhook-secret
MARKETPLACE_SLUG=diffpulse-ai-code-review
SUBSCRIPTION_STORE_PATH=./data/subscriptions.json

# Marketplace Plan IDs (from GitHub Org -> Marketplace -> Plans and pricing)
PLAN_ID_FREE=1
PLAN_ID_PRO=2
PLAN_ID_BUSINESS=3

# AI Provider used for Pro / Business tiers
AI_PROVIDER=openai
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
